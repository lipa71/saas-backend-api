APP_NAME="Enterprise B2B SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# LOGGING ARCHITECTURE
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# FOUNDATIONAL DATABASE INFRASTRUCTURE (DOCKER SAIL MYSQL)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

# SESSION & CACHE MANAGEMENT
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1

# ASYNCHRONOUS WORKER QUEUES (BROKER: REDIS)
QUEUE_CONNECTION=redis

# HIGH-PERFORMANCE IN-MEMORY CACHE (BROKER: REDIS)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# SECURE INBOUND SMTP COMMUNICATIONS (BROKER: MAILPIT)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="infrastructure@saasplatform.com"
MAIL_FROM_NAME="${APP_NAME}"

# EXTERNAL CORPORATE INTEGRATIONS
STRIPE_KEY=pk_test_mock_keys_enterprise_2026
STRIPE_SECRET=sk_test_mock_keys_enterprise_2026
